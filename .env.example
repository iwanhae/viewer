# The viewer is deployed as the Docker image, so these are the only settings a
# deployment supplies. Cache paths, upload limits and the checkpoint location
# are constants in internal/config.
PORT=8080

# Object store (Garage, MinIO, S3). Path-style addressing and the signing
# region are fixed at S3UsePathStyle=true / S3Region=us-east-1.
S3_ENDPOINT=https://s3.iwanhae.kr
S3_BUCKET=viewer
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
