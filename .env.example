# The viewer is deployed as the Docker image, so these are the only settings a
# deployment supplies. Upload limits and the checkpoint location are constants
# in internal/config.
PORT=8080

# Absolute directory holding the SQLite catalog (viewer.db) and the backup
# stamp that records which bucket backup it reflects. The catalog is the only
# thing that has to outlive the container: the album-to-photo mapping exists
# nowhere else, so mount a volume here. The image defaults to /var/lib/viewer,
# which it owns as uid 65532 and declares as a volume; a local run must point
# this at a writable directory instead.
STATE_DIR=/tmp/viewer-cache

# Object store (Garage, MinIO, S3). Any path prefix on the endpoint is kept. The
# signing region is fixed at S3Region=us-east-1.
S3_ENDPOINT=https://s3.iwanhae.kr
S3_BUCKET=viewer
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me

# true (default) addresses the bucket in the request path, https://host/bucket/key,
# which is what self-hosted stores expect. false uses a subdomain instead,
# https://bucket.host/key, and needs wildcard DNS for the endpoint.
S3_USE_PATH_STYLE=true

# Optional key prefix, so several deployments can share one bucket. Keys become
# <S3_PREFIX>/uploads/<albumId>.zip, <S3_PREFIX>/blobs/<sha256> and
# <S3_PREFIX>/backups/viewer.db — the catalog snapshot uploaded once the
# extraction queue drains and restored from at startup when it is newer than
# the local file. Leave empty to store objects at the bucket root.
S3_PREFIX=

# Base URL the SigLIP2 checkpoint is fetched from at first start: one download
# per <URL>/config.json, <URL>/model.safetensors and <URL>/tokenizer.json, into
# /app/siglip2. Empty uses the built-in public mirror of the default model.
# Point it at another mirror to serve a different checkpoint, or mount a
# prepared directory at /app/siglip2 and no download happens at all.
SIGLIP2_MODEL_URL=

# Base URL of the external Qdrant server vector search talks to over its REST
# API: the client appends a collection path, so <QDRANT_URL>/collections/...
# must reach it. This is also the switch for photo recommendations: leave
# empty to run without Qdrant — everything works except recommendations,
# which answer 503. A value must parse as an http or https URL with a host;
# a set-but-blank value is rejected at startup instead of silently meaning
# off.
QDRANT_URL=

# API key Qdrant expects on every request, sent as the api-key header only
# when set, so a server without authentication needs no placeholder. A
# set-but-blank value is rejected at startup instead of silently meaning off.
QDRANT_API_KEY=

# Name of the Qdrant collection that holds the per-photo embedding points.
# Required when QDRANT_URL is set, with no default, so nothing is ever
# created or queried under an accidental collection name. A set-but-blank
# value is rejected at startup instead of silently meaning off.
QDRANT_COLLECTION=

# Shared bearer token for the recommender and encoder worker APIs. Setting
# this enables WebP encoding and gates new non-WebP images until processing.
WORKER_TOKEN=

# Optional credential the admin page requires, sent as the Basic auth
# password. Empty keeps the admin UI disabled; the startup log says so. A
# set-but-blank value is rejected at startup instead of silently meaning off.
ADMIN_TOKEN=

# There are no caches to configure. Images stream straight from S3 on every
# request (repeat views are absorbed by the browser via the blob-hash ETag),
# and the staged zip being unpacked lives in the OS temp directory, which
# startup clears of leftovers from a crashed run. The checkpoint download in
# /app/siglip2 is the one reusable artifact; mount a volume there to keep it.
