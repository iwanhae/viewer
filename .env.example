# The viewer is deployed as the Docker image, so these are the only settings a
# deployment supplies. Upload limits and the checkpoint location are constants
# in internal/config.
PORT=8080

# Absolute directory holding the SQLite catalog (viewer.db) and the disk caches
# (images/, zips/). Mount a volume here: the catalog is the only record of the
# album-to-photo mapping, so losing it loses every album.
STATE_DIR=/tmp/viewer-cache

# Object store (Garage, MinIO, S3). Any path prefix on the endpoint is kept. The
# signing region is fixed at S3Region=us-east-1.
S3_ENDPOINT=https://s3.iwanhae.kr
S3_BUCKET=viewer
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me

# true (default) addresses the bucket in the request path, https://host/bucket/key,
# which is what self-hosted stores expect. false uses a subdomain instead,
# https://bucket.host/key, and needs wildcard DNS for the endpoint.
S3_USE_PATH_STYLE=true

# Optional key prefix, so several deployments can share one bucket. Keys become
# <S3_PREFIX>/blobs/<sha256>, <S3_PREFIX>/uploads/<albumId>.zip and
# <S3_PREFIX>/batch/<name>.zip. Leave empty to store objects at the bucket root.
S3_PREFIX=
