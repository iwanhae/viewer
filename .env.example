PORT=8080
S3_ENDPOINT=https://s3.iwanhae.kr
S3_REGION=garage
S3_BUCKET=viewer
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_USE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=1073741824
CACHE_DIR=.cache/images
ZIP_CACHE_DIR=.cache/zips
DB_PATH=.cache/viewer.db
INGEST_DELETE_SOURCE=true
WARMUP_FETCH_CONCURRENCY=0
EMBEDDING_ENABLED=true
# A HuggingFace repository id, or a local directory holding config.json and
# model.safetensors.
EMBEDDING_MODEL_ID=google/siglip2-base-patch16-224
# GoMLX backend: "go" is pure Go (no CGO); "xla:cpu" is much faster but
# downloads a PJRT runtime and needs CGO.
EMBEDDING_BACKEND=go
# Optional HuggingFace cache root used when downloading the checkpoint.
EMBEDDING_CACHE_DIR=
# Fail startup when the model cannot be loaded (default false: run without
# embeddings).
EMBEDDING_REQUIRED=false
# Background embedding workers (0 means auto).
EMBEDDING_CONCURRENCY=0
# Timeout per image, covering preprocessing plus inference.
EMBEDDING_REQUEST_TIMEOUT_SECONDS=300
