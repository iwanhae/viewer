# Viewer server the worker pulls embedding work from.
VIEWER_BASE_URL=https://albums.iwanhae.kr

# Bearer token; must match the server's EMBEDDING_WORKER_TOKEN.
# (EMBEDDING_WORKER_TOKEN is accepted as a fallback name, so a repo-root
# .env shared with the server works as-is.)
VIEWER_WORKER_TOKEN=

# Checkpoint mirror serving config.json + model.safetensors. Defaults to
# the server's own mirror of google/siglip2-base-patch16-224.
#SIGLIP2_MODEL_URL=https://s3.iwanhae.kr/public/google/siglip2-base-patch16-224

# Point at a local model.safetensors to skip the download entirely.
#SIGLIP2_MODEL=

# Optional tuning (defaults shown).
#CLAIM_LIMIT=64
#MICRO_BATCH=0
#POLL_INTERVAL=20
#DOWNLOAD_WORKERS=8
#DEVICE=auto
#MODEL_CACHE_DIR=
#HTTP_TIMEOUT=60
#LOG_LEVEL=INFO
